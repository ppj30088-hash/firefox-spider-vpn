# Builds. dist/ may hold a data folder with account credentials.
/dist/
*.exe
*.aar
*.apk
*.aab
*.ipa
*.dmg
*.msix
/core/cmd/firefox-vpn-core/firefox-vpn-core
/core/firefox-vpn-core*
# The Windows resources (icon, version) of the core and the TUN service,
# made by the build: go generate ./cmd/firefox-vpn-core ./cmd/firefox-vpn-tun
/core/cmd/firefox-vpn-core/rsrc_windows_*.syso
/core/cmd/firefox-vpn-tun/rsrc_windows_*.syso
/core/cmd/firefox-vpn-tun/firefox-vpn-tun
# Update signing keys (tools/sign) never go into the repository.
*.signing-key
# gomobile's output for the Android app (core.aar, core-sources.jar),
# rebuilt from core/ (see core/doc/DEVELOPMENT.md).
/app/android/app/libs/

# Portable data folders (config, account credentials, tokens, logs).
data/
user-data/
h3-test-data/
# scripts/h3-test.py writes its report next to itself.
/scripts/report.txt

# Secrets, wherever they end up.
credentials.json
secret.key
local-api.token
dashboard.key
*.jks
*.keystore
key.properties
.env
.env.*
*.pem
# Public root certificates the Android core embeds (no key): source.
!/core/mobile/extra-roots.pem
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Logs
*.log
logs/

# Go tooling output
*.test
*.out
*.prof
coverage.*

# Python
__pycache__/
*.pyc

# Editors and operating systems
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
desktop.ini
